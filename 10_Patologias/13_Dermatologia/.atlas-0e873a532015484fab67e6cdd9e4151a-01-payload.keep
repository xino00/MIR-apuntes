>
> %% atlas-item file=pag-006-img-04-papulas-poligonales-planas-con-brillo-liquenoide-y-estrias-de-whickam-correspondientes-a-un.jpg sha256=e45e0efa52b4045c8667086e7d7968bd2df95dffa07c0cc58de73008a3410d83 panel_group=- panel_label=- pdf_page=6 %%
